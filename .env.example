# PayPal sandbox only. Supply your own sandbox credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Use the same database for the application and local approval CLI.
# Run commands from the project root; relative paths resolve from there.
PAYPAL_DATABASE_PATH=./data/operations.sqlite

